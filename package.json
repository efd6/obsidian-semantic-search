{
	"name": "obsidian-semantic-search-plugin",
	"version": "1.0.0",
	"description": "AI-powered semantic search for Obsidian with offline operation",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && npm run lint && node esbuild.config.mjs production",
		"build:dev": "npm run typecheck && npm run lint && node esbuild.config.mjs development",
		"build:prod": "npm run download-models && npm run build && npm run bundle-check",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:performance": "jest tests/performance/",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"typecheck": "tsc --noEmit",
		"download-models": "node scripts/download-models.mjs",
		"bundle-check": "node scripts/bundle-analyzer.mjs",
		"clean": "rm -rf build/ dist/ models/ main*.js main*.js.map test-*.js",
		"deploy": "npm run build && cp -r build/plugin/* .obsidian/plugins/semantic-search-plugin/",
		"deploy:dev": "npm run build:dev && cp -r build/plugin/* .obsidian/plugins/semantic-search-plugin/",
		"prepare-release": "npm run clean && npm run build:prod && npm run test"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"semantic-search",
		"ai",
		"offline"
	],
	"author": "Upstart Engineering",
	"license": "MIT",
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
		"@types/jest": "^29.5.14",
		"@types/micromatch": "^4.0.9",
		"@types/node": "^20.6.0",
		"@typescript-eslint/eslint-plugin": "^8.44.0",
		"@typescript-eslint/parser": "^8.44.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.19.2",
		"eslint": "^9.35.0",
		"eslint-import-resolver-typescript": "^3.10.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^17.23.1",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-security": "^3.0.1",
		"eslint-plugin-sonarjs": "^3.0.5",
		"eslint-plugin-unicorn": "^54.0.0",
		"fake-indexeddb": "^6.2.2",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jest-environment-obsidian": "^0.0.1",
		"ts-jest": "^29.1.1",
		"tslib": "^2.8.1",
		"typescript": "5.2.2",
		"typescript-eslint": "^8.44.0"
	},
	"dependencies": {
		"@tensorflow-models/universal-sentence-encoder": "^1.3.3",
		"@tensorflow/tfjs": "^4.15.0",
		"idb": "^7.1.1",
		"micromatch": "^4.0.8",
		"obsidian": "latest",
		"rxdb": "^15.8.1"
	}
}
